rules_version = '2';

// 끼리끼리 Cloud Storage 보안 규칙.
//
// 앱이 올리는 이미지는 두 경로뿐이다(FirebaseStorageDataSourceImpl.uploadImage).
//   requests/{uuid}.jpg  : 요청에 첨부하는 이미지 (RequestViewModel)
//   response/{uuid}.jpg  : 응답에 첨부하는 이미지 (ResponseViewModel)
// 프로필 이미지는 카카오 URL 을 그대로 쓰며 Storage 에 올리지 않는다.
//
// 파일 경로에 그룹 ID 가 없어서 "같은 그룹 멤버만 읽기"는 규칙으로 판단할 수 없다.
// 인증된 사용자만 읽고 쓸 수 있고, 업로드는 크기/타입을 제한한다.
// 한 번 발급된 다운로드 URL(토큰 포함)은 이 규칙과 무관하게 열린다.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImageUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /requests/{fileName} {
      allow read: if isSignedIn();
      // 새 파일만 만든다(UUID 파일명). 덮어쓰기/삭제는 앱에 경로가 없다.
      allow create: if isSignedIn() && isValidImageUpload();
      allow update, delete: if false;
    }

    match /response/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidImageUpload();
      allow update, delete: if false;
    }

    // 그 외 모든 경로는 거부.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
