rules_version = '2';

// 끼리끼리 Firestore 보안 규칙.
//
// 전제: 앱이 카카오 로그인 후 kakaoCustomToken 함수로 받은 커스텀 토큰으로
// Firebase Auth에 로그인한다. 이때 request.auth.uid 는 카카오 회원번호(문자열)이며,
// user_data 문서 ID 및 group_data._groupUserDocumentID 에 들어 있는 값과 같다.
//
// 주의: 클라이언트가 Firebase Auth에 로그인하기 전에 이 규칙을 적용하면
// 모든 읽기/쓰기가 거부된다. 배포 순서는 docs/보안규칙_설계.md 를 따른다.
// Cloud Functions(Admin SDK)는 규칙을 우회하므로 영향이 없다.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // 공통 함수
    // ---------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // group_data/{groupId} 의 멤버 목록에 로그인한 사용자가 들어 있는지.
    // 그룹 문서가 없거나 필드가 없으면 평가 오류가 되어 거부된다.
    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in
          get(/databases/$(database)/documents/group_data/$(groupId))
            .data._groupUserDocumentID;
    }

    // question_data 문서 ID 는 "{groupId}_{yyyyMMdd}" 형식이다.
    // 그룹 ID(Firestore 자동 ID)에는 '_' 가 없으므로 첫 조각이 그룹 ID 다.
    function questionGroupId(questionId) {
      return questionId.split('_')[0];
    }

    // ---------------------------------------------------------------
    // user_data/{userId}   (문서 ID = 카카오 회원번호)
    // ---------------------------------------------------------------

    // FCM 토큰 교체 시 같은 기기의 이전 계정 문서에서 토큰을 지우는 쓰기.
    // 다른 사용자 문서에서 _userFcmToken 만 바뀌고, 그 배열이 "줄어들기만"
    // 해야 한다(남의 문서에 토큰을 추가해 알림을 가로채는 것을 막는다).
    function isOnlyFcmTokenRemoval() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['_userFcmToken'])
        && resource.data._userFcmToken is list
        && request.resource.data._userFcmToken is list
        && resource.data._userFcmToken
          .hasAll(request.resource.data._userFcmToken)
        && request.resource.data._userFcmToken.size()
          < resource.data._userFcmToken.size();
    }

    match /user_data/{userId} {
      // 그룹원의 이름/프로필 조회(get), 로그인 시 전체 조회(list),
      // FCM 토큰 정리용 array-contains 쿼리(list)가 쓰인다.
      allow get, list: if isSignedIn();

      // 본인 문서만 만든다. _userId 필드가 있다면 문서 ID 와 같아야 한다.
      allow create: if isUser(userId)
        && request.resource.data.get('_userId', userId) == userId;

      // 본인 문서는 자유롭게, 남의 문서는 토큰 제거만 허용한다.
      allow update: if (isUser(userId)
          && request.resource.data.get('_userId', userId) == userId)
        || isOnlyFcmTokenRemoval();

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // group_data/{groupId}
    // ---------------------------------------------------------------

    match /group_data/{groupId} {
      // 단건 조회는 멤버만.
      allow get: if isSignedIn()
        && request.auth.uid in resource.data._groupUserDocumentID;

      // 그룹 코드로 조회(getGroupByCode, isGroupCodeExist)는 가입 전 사용자도
      // 해야 한다. 쿼리 필터는 규칙에서 강제할 수 없으므로 limit(1) 쿼리만
      // 허용해 한 번에 여러 그룹을 훑지 못하게 한다.
      // (request.query.limit 이 없는 쿼리는 평가 오류로 거부된다.)
      allow list: if isSignedIn() && request.query.limit <= 1;

      // 생성: 멤버 목록은 비어 있거나 본인 한 명뿐이어야 한다.
      // (앱은 빈 목록으로 만든 뒤 addUserToGroup 으로 본인을 추가한다.)
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          '_groupState', '_groupName', '_groupCode', '_groupPw',
          '_groupUserDocumentID', '_groupRequestDocumentID',
          '_groupQuestionDocumentID'
        ])
        && request.resource.data.keys().hasAll([
          '_groupName', '_groupCode', '_groupPw', '_groupUserDocumentID'
        ])
        && request.resource.data._groupName is string
        && request.resource.data._groupCode is string
        && request.resource.data._groupCode.size() > 0
        && request.resource.data._groupPw is string
        && request.resource.data._groupUserDocumentID is list
        && (request.resource.data._groupUserDocumentID.size() == 0
          || (request.resource.data._groupUserDocumentID.size() == 1
            && request.resource.data._groupUserDocumentID[0]
              == request.auth.uid));

      allow update: if isSignedIn() && (
        // 멤버: 그룹명/비밀번호 변경(멤버 목록이 그대로면 diff 에 잡히지 않는다).
        (request.auth.uid in resource.data._groupUserDocumentID
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['_groupName', '_groupPw']))
        // 멤버: 본인만 목록에서 제거(탈퇴).
        || (request.auth.uid in resource.data._groupUserDocumentID
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['_groupUserDocumentID'])
          && !(request.auth.uid
            in request.resource.data._groupUserDocumentID)
          && resource.data._groupUserDocumentID
            .hasAll(request.resource.data._groupUserDocumentID)
          && request.resource.data._groupUserDocumentID.size()
            == resource.data._groupUserDocumentID.size() - 1)
        // 비멤버: 본인만 목록에 추가(가입). 비밀번호 확인은 규칙으로 못 한다.
        || (!(request.auth.uid in resource.data._groupUserDocumentID)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['_groupUserDocumentID'])
          && request.auth.uid in request.resource.data._groupUserDocumentID
          && request.resource.data._groupUserDocumentID
            .hasAll(resource.data._groupUserDocumentID)
          && request.resource.data._groupUserDocumentID.size()
            == resource.data._groupUserDocumentID.size() + 1)
      );

      // 앱에 그룹 삭제 경로가 없다.
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // question_data/{groupId}_{yyyyMMdd}  (+ answer_data 하위 컬렉션)
    // ---------------------------------------------------------------

    match /question_data/{questionId} {
      // 일일 질문 생성 트랜잭션이 아직 없는 문서를 get 하므로 resource 가 아니라
      // 문서 ID 에서 그룹을 뽑아 판단한다.
      allow get: if isGroupMember(questionGroupId(questionId));

      // 그룹 ID 로 거는 쿼리(getAllQuestionsForGroup 등)는 필드 값으로 판단한다.
      allow list: if isGroupMember(resource.data._questionGroupDocumentId);

      allow create: if isGroupMember(questionGroupId(questionId))
        && questionId.matches('^[^_]+_[0-9]{8}$')
        && request.resource.data.keys().hasOnly([
          '_questionId', '_questionCreatedTime',
          '_questionGroupDocumentId', '_questionListDocumentId'
        ])
        && request.resource.data._questionGroupDocumentId
          == questionGroupId(questionId);

      // 질문은 만들어진 뒤 바뀌거나 지워지지 않는다.
      allow update, delete: if false;

      match /answer_data/{answerId} {
        allow read: if isGroupMember(questionGroupId(questionId));

        allow create: if isGroupMember(questionGroupId(questionId))
          && request.resource.data._answerUserDocumentID == request.auth.uid;

        allow update: if isGroupMember(questionGroupId(questionId))
          && resource.data._answerUserDocumentID == request.auth.uid
          && request.resource.data._answerUserDocumentID == request.auth.uid;

        allow delete: if isGroupMember(questionGroupId(questionId))
          && resource.data._answerUserDocumentID == request.auth.uid;
      }
    }

    // ---------------------------------------------------------------
    // questionlist_data: 질문 은행. 앱은 읽기만 한다(관리는 콘솔/Admin).
    // ---------------------------------------------------------------

    match /questionlist_data/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // request_data/{requestId}  (+ response_data 하위 컬렉션)
    // ---------------------------------------------------------------

    match /request_data/{requestId} {
      // 단건 리스너가 삭제된 문서에도 오류 없이 "없음"을 받게 resource == null 허용.
      allow get: if isSignedIn()
        && (resource == null
          || isGroupMember(resource.data._requestGroupDocumentID));

      // 반드시 whereEqualTo("_requestGroupDocumentID", groupId) 쿼리여야 통과한다.
      // 컬렉션 전체를 get()/addSnapshotListener 하는 현재 앱 코드는 거부된다.
      allow list: if isGroupMember(resource.data._requestGroupDocumentID);

      allow create: if isSignedIn()
        && request.resource.data._requestUserDocumentID == request.auth.uid
        && isGroupMember(request.resource.data._requestGroupDocumentID);

      // 현재 앱에 요청 수정/삭제 경로가 없다(Datasource 는 TODO).
      allow update, delete: if false;

      match /response_data/{responseId} {
        allow read: if isGroupMember(
          get(/databases/$(database)/documents/request_data/$(requestId))
            .data._requestGroupDocumentID);

        allow create: if request.resource.data._responseUserId
            == request.auth.uid
          && isGroupMember(
            get(/databases/$(database)/documents/request_data/$(requestId))
              .data._requestGroupDocumentID);

        allow update: if resource.data._responseUserId == request.auth.uid
          && request.resource.data._responseUserId == request.auth.uid
          && isGroupMember(
            get(/databases/$(database)/documents/request_data/$(requestId))
              .data._requestGroupDocumentID);

        allow delete: if resource.data._responseUserId == request.auth.uid
          && isGroupMember(
            get(/databases/$(database)/documents/request_data/$(requestId))
              .data._requestGroupDocumentID);
      }
    }

    // ---------------------------------------------------------------
    // 그 외 모든 경로(test_collection 등)는 거부.
    // ---------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
